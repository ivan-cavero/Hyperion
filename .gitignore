**/*.rs.bk

# Build tooling
Cargo.lock.orig

# IDEs
.idea/
.vscode/
*.iml

# OS
Thumbs.db
.DS_Store

# Logs / runtime (default vanilla paths; do not commit live server state)
*.log
server.properties
world/
ops.json
whitelist.json
banned-players.json
